# Required before docker compose up
MAIL_JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated domains accepted by the server
MAIL_DOMAINS=example.com
MAIL_ADMIN=admin@example.com

# Set this to a secret when using the /internal/email webhook
MAIL_INBOUND_TOKEN=

# Docker host ports
HTTP_PORT=8787
SMTP_PORT=25
MAIL_SMTP_ENABLED=true
